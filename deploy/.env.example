# Copy to deploy/.env on the SERVER and fill in. This file is read by `docker compose` there. Never commit .env.

# --- Public address -------------------------------------------------------------------------
# ":80" = plain HTTP (local testing). A domain = automatic HTTPS, e.g. portfolio.example.com
SITE_ADDRESS=:80
# Full public URL (used for CORS and the social-preview image links). Leave empty for local testing.
SITE_URL=
# Only change these for local testing (e.g. HTTP_PORT=8088) to avoid clashing with something on port 80.
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Secrets (generate long random values) -------------------------------------------------
# Admin login password: 12+ characters; production refuses to start with a weak one.
ADMIN_PASSWORD=
# Signs admin sessions:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Protects Redis inside the Docker network. Use letters and digits only (it is embedded in a URL).
REDIS_PASSWORD=

# --- Optional -------------------------------------------------------------------------------
# Raises GitHub's API limit (public repos need no scopes).
GITHUB_TOKEN=

# --- Images ---------------------------------------------------------------------------------
# Published by the CI/CD pipeline. IMAGE_TAG=<git sha> pins a version (that is how you roll back).
IMAGE_PREFIX=ghcr.io/iamshuvokd/shuvo_portfolio
IMAGE_TAG=latest
