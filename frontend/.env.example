# Copy to .env.local and adjust. Only VITE_* values reach the browser — never put secrets here.

# Future backend API base URL. When set, the contact form posts here instead of EmailJS.
# VITE_API_URL=http://localhost:4000/api

# EmailJS (current contact transport). Defaults are built in; override per environment.
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=
