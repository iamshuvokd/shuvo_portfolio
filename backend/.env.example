# Copy to backend/.env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Redis (start locally with: docker compose up -d redis)
REDIS_URL=redis://127.0.0.1:6379

# Password you type on /admin. Use something long and unique.
ADMIN_PASSWORD=change-me-to-a-long-password

# Signs admin session tokens. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-24-chars

JWT_EXPIRES_IN=12h

# Browser origins allowed to call the API (comma separated). Not needed when using the Vite proxy.
CORS_ORIGINS=http://localhost:8080

MAX_UPLOAD_MB=8

# Optional: GitHub token (no scopes needed for public repos) to lift the API limit from 60 to 5000 req/hour.
# GITHUB_TOKEN=

# Abuse limits (defaults shown). Public reads per IP per minute, and live-update connections.
# PUBLIC_RATE_LIMIT=300
# SSE_MAX_PER_IP=25
# SSE_MAX_TOTAL=1000
